# Copy this file to secrets.yaml (same folder as the doorbell-sound*.yaml files,
# i.e. [homeassistant]/config/esphome/secrets.yaml) and fill in your own values.
# secrets.yaml is git-ignored so your credentials are never committed.
#
# You only need the keys for the variant(s) you actually build.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# Home Assistant API encryption keys - generate one per device with:
#   openssl rand -base64 32
doorbell_api_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"            # doorbell-sound.yaml (I2S + local WAV)
doorbell_sd_card_api_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"    # doorbell-sound-sd-card.yaml (DFPlayer)
doorbell_streaming_api_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"  # doorbell-sound-streaming-audio.yaml

# OTA update passwords - any strong string
doorbell_ota_pw: "REPLACE_WITH_A_STRONG_PASSWORD"
doorbell_sd_card_ota_pw: "REPLACE_WITH_A_STRONG_PASSWORD"
doorbell_streaming_ota_pw: "REPLACE_WITH_A_STRONG_PASSWORD"

# Fallback hotspot passwords (min. 8 chars) for the AP shown when WiFi fails
doorbell_fallback_pw: "REPLACE_WITH_A_STRONG_PASSWORD"
doorbell_sd_card_fallback_pw: "REPLACE_WITH_A_STRONG_PASSWORD"
doorbell_streaming_fallback_pw: "REPLACE_WITH_A_STRONG_PASSWORD"
